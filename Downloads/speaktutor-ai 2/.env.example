# ─────────────────────────────────────────────────────────────────────────────
# SpeakTutor AI — Environment Variables
# Copy this file to .env and fill in all required values.
# Never commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL connection string.
# For Supabase: use the connection pooler URI (Transaction mode, port 6543)
# Example: postgresql://postgres.xxx:password@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
DATABASE_URL=

# ── AI (OpenAI) ──────────────────────────────────────────────────────────────
# Required for speech recognition (Whisper), AI responses (GPT-4o), and TTS.
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ── Auth ─────────────────────────────────────────────────────────────────────
# Secret used to sign JWT tokens. Use a long random string (32+ characters).
# Generate with: openssl rand -base64 32
SESSION_SECRET=

# ── Supabase (optional — only if using the Supabase JS client directly) ──────
# The DATABASE_URL above is sufficient for the backend (Drizzle uses it directly).
# These vars are only needed if you add Supabase client SDK calls to the frontend.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── YooKassa Payments ─────────────────────────────────────────────────────────
# Required to accept real payments.
# Get credentials at: https://yookassa.ru → Integrations → HTTP API
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# Return URL after YooKassa payment (must be a publicly accessible HTTPS URL).
# Example: https://your-app.onrender.com/speaktutor/payment/return
YOOKASSA_RETURN_URL=
